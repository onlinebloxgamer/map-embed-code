---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
---

<BaseLayout
    title="Page Not Found – Map Embed Code"
    description="The requested page could not be found. Return to the Google Maps embed code generator or browse our guides."
    canonical="https://map-embed-code.com/404.html"
    robots="noindex, follow"
>
    <Header />
    <main id="main-content" class="error-page">
        <div class="container error-layout">
            <div class="map-illustration" aria-hidden="true">
                <span class="error-code">404</span>
                <svg viewBox="0 0 520 280" role="presentation">
                    <path class="road road-shadow" d="M-30 235C70 185 95 82 195 91s115 133 206 94 70-118 151-141" />
                    <path class="road" d="M-30 235C70 185 95 82 195 91s115 133 206 94 70-118 151-141" />
                    <path class="route" d="M-30 235C70 185 95 82 195 91s115 133 206 94 70-118 151-141" />
                    <g class="pin" transform="translate(346 136)">
                        <path d="M0-38c-22 0-40 17.5-40 39.2C-40 31 0 70 0 70s40-39 40-68.8C40-20.5 22-38 0-38Z" />
                        <circle cx="0" cy="1" r="13" />
                    </g>
                    <g class="lost-marker" transform="translate(195 91)">
                        <circle r="18" />
                        <path d="M-6-5c1.5-5 10-6 12-1 3 7-6 7-6 14M0 14v1" />
                    </g>
                </svg>
            </div>

            <div class="error-copy readable-surface">
                <span class="text-mono-eyebrow">Error 404</span>
                <h1 class="text-heading-lg">This pin isn’t on the map</h1>
                <p>
                    The page may have moved, the address may be incomplete, or
                    the route may no longer exist.
                </p>
                <div class="error-actions">
                    <a href="/#generator" class="btn-primary">Back to the generator</a>
                    <a href="/guides/" class="btn-secondary">Browse guides</a>
                </div>
                <div class="helpful-links" aria-label="Helpful links">
                    <a href="/guides/embed-google-maps-wordpress/">WordPress guide</a>
                    <a href="/guides/embed-google-maps-shopify/">Shopify guide</a>
                    <a href="/guides/embed-google-map-multiple-locations/">Multiple locations</a>
                </div>
            </div>
        </div>
    </main>
    <Footer />
</BaseLayout>

<style>
    .error-page {
        display: grid;
        min-height: calc(100vh - 56px);
        padding: var(--spacing-3xl) 0;
        place-items: center;
    }

    .error-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(340px, .85fr);
        align-items: center;
        gap: var(--spacing-xl);
        width: 100%;
    }

    .map-illustration {
        position: relative;
        overflow: hidden;
        min-height: 360px;
        border: 1px solid rgba(32, 94, 56, .16);
        border-radius: var(--radius-lg);
        background:
            linear-gradient(rgba(255,255,255,.28), rgba(255,255,255,.28)),
            url('/map-background.webp') center / cover;
        box-shadow: 0 24px 60px rgba(32, 94, 56, .14);
    }

    .error-code {
        position: absolute;
        top: 22px;
        left: 26px;
        z-index: 2;
        color: rgba(32, 94, 56, .22);
        font-family: var(--font-mono);
        font-size: clamp(70px, 11vw, 132px);
        font-weight: 600;
        letter-spacing: -.08em;
        line-height: 1;
    }

    .map-illustration svg {
        position: absolute;
        inset: auto 0 0;
        width: 100%;
        height: auto;
    }

    .road, .route { fill: none; stroke-linecap: round; }
    .road-shadow { stroke: rgba(23,23,23,.13); stroke-width: 27; }
    .road { stroke: #fff; stroke-width: 19; }
    .route { stroke: var(--color-map-water); stroke-width: 4; stroke-dasharray: 8 10; }
    .pin path { fill: #d94b3f; stroke: #fff; stroke-width: 4; }
    .pin circle { fill: #fff; }
    .lost-marker circle { fill: #fff; stroke: var(--color-map-green-deep); stroke-width: 3; }
    .lost-marker path { fill: none; stroke: var(--color-map-green-deep); stroke-width: 3; stroke-linecap: round; }

    .error-copy { padding: var(--spacing-xl); }
    .error-copy .text-mono-eyebrow { color: var(--color-error-deep); }
    .error-copy h1 { margin: var(--spacing-sm) 0; color: var(--color-ink); }
    .error-copy > p { margin: 0 0 var(--spacing-lg); color: var(--color-body); font-size: 16px; line-height: 25px; }
    .error-actions { display: flex; flex-wrap: wrap; gap: var(--spacing-sm); }
    .helpful-links { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: var(--spacing-lg); padding-top: var(--spacing-md); border-top: 1px solid var(--color-hairline); }
    .helpful-links a { color: var(--color-link); font-size: 13px; text-decoration: none; }
    .helpful-links a:hover { text-decoration: underline; }

    @media (max-width: 800px) {
        .error-page { padding: var(--spacing-xl) 0; }
        .error-layout { grid-template-columns: 1fr; }
        .map-illustration { min-height: 280px; }
    }

    @media (max-width: 480px) {
        .map-illustration { min-height: 220px; }
        .error-copy { padding: var(--spacing-lg); }
        .error-actions { align-items: stretch; flex-direction: column; }
    }
</style>
