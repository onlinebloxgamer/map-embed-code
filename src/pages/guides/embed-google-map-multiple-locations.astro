---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const pageUrl = 'https://map-embed-code.com/guides/embed-google-map-multiple-locations/';
const pageTitle = 'How to Embed a Google Map with Multiple Locations';
const pageDescription = 'Learn how to embed a Google Map with multiple locations using Google My Maps. Add pins, make the map public, and generate responsive embed code.';

const steps = [
  {
    id: 'create-map',
    title: 'Open Google My Maps and create a new map',
    image: '/guides/step-1-create-multiple-marker-google-map.webp',
    alt: 'Google My Maps dashboard showing the Create a New Map button',
  },
  {
    id: 'name-map',
    title: 'Name and save your custom map',
    image: '/guides/step-2-name-google-my-map.webp',
    alt: 'Google My Maps dialog for entering and saving a custom map title',
  },
  {
    id: 'add-first-location',
    title: 'Search for and add your first location',
    image: '/guides/step-3-add-first-location-google-my-maps.webp',
    alt: 'Google My Maps search result for Columbia University with Add to map highlighted',
  },
  {
    id: 'add-and-style-locations',
    title: 'Add more locations, style the markers, and select Share',
    image: '/guides/step-4-add-multiple-locations-style-markers.webp',
    alt: 'Google My Maps with multiple locations, marker color controls, and Share button',
  },
  {
    id: 'share-and-copy-link',
    title: 'Allow link access and copy the My Maps URL',
    image: '/guides/step-5-share-google-my-map-copy-link.webp',
    alt: 'Google My Maps sharing dialog with Anyone with this link can view enabled and the map URL ready to copy',
  },
  {
    id: 'responsive-code',
    title: 'Paste the URL and generate responsive embed code',
    image: '/guides/step-6-generate-multiple-location-map-embed-code.webp',
    alt: 'Map Embed Code generator showing a pasted My Maps URL, multiple-marker preview, and Generate Code button',
  },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: pageTitle,
  description: pageDescription,
  image: 'https://map-embed-code.com/guides/multiple-locations-video-thumbnail.jpg',
  totalTime: 'PT10M',
  supply: [{ '@type': 'HowToSupply', name: 'A list of locations or addresses' }],
  tool: [
    { '@type': 'HowToTool', name: 'Google account' },
    { '@type': 'HowToTool', name: 'Google My Maps' },
    { '@type': 'HowToTool', name: 'Map Embed Code generator' },
  ],
  step: steps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: step.title,
    url: `${pageUrl}#${step.id}`,
    image: `https://map-embed-code.com${step.image}`,
    text: [
      'Open Google My Maps from the generator and select Create a New Map.',
      'Open Untitled map, enter a descriptive map title, and save it.',
      'Search for the first address or place and select Add to map.',
      'Repeat the search for the remaining locations, style the markers, and select Share.',
      'Enable Anyone with this link can view and copy the shared Google My Maps URL.',
      'Paste the shared URL into the generator My Maps field and generate responsive website code.',
    ][index],
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Can I embed multiple locations on Google Maps without an API key?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Create the locations in Google My Maps, allow visitors with the link to view it, and paste the shared URL into the My Maps generator. This method does not require a Google Maps API key.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I add many locations at once?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Google My Maps can import addresses or coordinates from a CSV, XLSX file, or Google Sheet. Each imported layer can contain up to 2,000 map features.',
      },
    },
    {
      '@type': 'Question',
      name: 'Will a multi-location Google Map work on mobile?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, when the iframe is placed inside a responsive wrapper so its width follows the screen while its aspect ratio stays consistent.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is a multiple-location map the same as a multi-stop route?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. A multiple-location map displays independent pins. A multi-stop route connects an origin, intermediate stops, and a destination in travel order.',
      },
    },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description: pageDescription,
  image: 'https://map-embed-code.com/guides/multiple-locations-video-thumbnail.jpg',
  datePublished: '2026-10-19',
  dateModified: '2026-10-19',
  author: { '@type': 'Organization', name: 'Map Embed Code' },
  publisher: {
    '@type': 'Organization',
    name: 'Map Embed Code',
    url: 'https://map-embed-code.com/',
    logo: { '@type': 'ImageObject', url: 'https://map-embed-code.com/favicon-96x96.png' },
  },
  mainEntityOfPage: pageUrl,
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  ogImage="/guides/multiple-locations-video-thumbnail.jpg"
  ogType="article"
  publishedTime="2026-10-19"
  modifiedTime="2026-10-19"
  structuredData={[articleSchema, howToSchema, faqSchema]}
  lang="en"
  alternatePath="/guides/embed-google-map-multiple-locations/"
>
  <Header lang="en" translationPath="/guides/embed-google-map-multiple-locations/" />
  <main id="main-content">
    <div class="page-hero">
      <div class="container readable-surface hero-surface">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/guides/">Guides</a><span aria-hidden="true">/</span><span>Multiple locations</span>
        </nav>
        <span class="text-mono-eyebrow" style="color:var(--color-mute);">Google My Maps</span>
        <h1 class="text-heading-lg page-h1">How to Embed a Google Map with Multiple Locations</h1>
        <p class="text-body-lg hero-copy">
          Create one interactive map with multiple location markers, then embed it on your website with responsive code. This guide uses Google My Maps and does not require a Google Maps API key.
        </p>
        <div class="article-meta" aria-label="Article information">
          <span>Updated October 19, 2026</span><span aria-hidden="true">•</span><span>10 minute read</span>
        </div>
      </div>
    </div>

    <div class="prose-section">
      <article class="container prose-container readable-surface">
        <p class="intro">
          A standard Google Maps iframe usually focuses on one address. If your business has several branches, service areas, pickup points, event venues, or properties, Google My Maps lets you place them on one custom map. You can label and color the pins, group them into layers, and publish the finished map as an iframe.
        </p>

        <aside class="quick-answer" aria-labelledby="quick-answer-title">
          <h2 id="quick-answer-title">Quick answer</h2>
          <p>
            Open the <a href="/#generator">My Maps tab in our generator</a> and follow its Google My Maps link. Create and name a map, add and style every location, enable <strong>Anyone with this link can view</strong>, and copy the shared URL. Paste that URL back into the generator to create responsive embed code.
          </p>
        </aside>

        <nav class="toc card" aria-labelledby="toc-title">
          <h2 class="toc-heading" id="toc-title">In this guide</h2>
          <ol class="toc-list">
            <li><a href="#video">Watch the video walkthrough</a></li>
            {steps.map((step, index) => <li><a href={`#${step.id}`}>Step {index + 1}: {step.title}</a></li>)}
            <li><a href="#bulk-import">Add locations in bulk with a spreadsheet</a></li>
            <li><a href="#troubleshooting">Troubleshooting</a></li>
            <li><a href="#faq">Frequently asked questions</a></li>
          </ol>
        </nav>

        <section class="prose-block" id="video">
          <h2>Watch: create a multiple-location map in Google My Maps</h2>
          <p>
            The video below demonstrates the Google My Maps workflow used in this guide. Watch it once for the overall process, then follow the illustrated steps for the exact embed setup.
          </p>
          <div class="video-frame">
            <iframe
              src="https://www.youtube-nocookie.com/embed/yIkfpkLjEEs"
              title="How to Create a Multiple Locations Map on Google – Full Tutorial"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
          <p class="media-caption">
            Video: <a href="https://www.youtube.com/watch?v=yIkfpkLjEEs" target="_blank" rel="noopener noreferrer">How to Create a Multiple Locations Map on Google – Full Tutorial</a>.
          </p>
        </section>

        <section class="prose-block" id="create-map">
          <p class="step-kicker">Step 1</p>
          <h2>Open Google My Maps and create a new map</h2>
          <p>
            On the generator, select <strong>My Maps</strong> under Location and use the <strong>Open Google My Maps</strong> link. Sign in to the Google account that should own the map. On the My Maps dashboard, select <strong>Create a New Map</strong> to open a blank map editor.
          </p>
          <p>
            If the dashboard shows maps from another account, switch accounts before continuing. The account that creates the map controls its locations, styling, and sharing permissions.
          </p>
          <figure class="step-figure">
            <img src={steps[0].image} alt={steps[0].alt} width="1280" height="720" loading="lazy" />
            <figcaption>In Google My Maps, select “Create a New Map” to begin your multiple-marker map.</figcaption>
          </figure>
        </section>

        <section class="prose-block" id="name-map">
          <p class="step-kicker">Step 2</p>
          <h2>Name and save your custom map</h2>
          <p>
            In the upper-left panel, select <strong>Untitled map</strong>. Enter a short, descriptive title such as <strong>Our Store Locations</strong>, <strong>Pickup Points</strong>, or <strong>Conference Venues</strong>. Add an optional description that explains what the markers represent, then select <strong>Save</strong>.
          </p>
          <p>
            A clear title helps you identify the correct map later, especially if you manage several My Maps projects. This title can also appear when visitors open the embedded map.
          </p>
          <figure class="step-figure">
            <img src={steps[1].image} alt={steps[1].alt} width="1280" height="720" loading="lazy" />
            <figcaption>Replace “Untitled map” with a meaningful map title and save it.</figcaption>
          </figure>
        </section>

        <section class="prose-block" id="add-first-location">
          <p class="step-kicker">Step 3</p>
          <h2>Search for and add your first location</h2>
          <p>
            Type the first business name, landmark, or complete street address into the search bar. Choose the correct result and check its address in the information card. When the location is correct, select <strong>Add to map</strong>. The place will be saved in the active layer and will remain visible after you run another search.
          </p>
          <p>
            If several results have similar names, include the city, state or region, and postal code. For a place that is not searchable, use the marker tool to place a pin manually and give it a clear name.
          </p>
          <figure class="step-figure">
            <img src={steps[2].image} alt={steps[2].alt} width="1280" height="720" loading="lazy" />
            <figcaption>Confirm the correct search result, then select “Add to map.”</figcaption>
          </figure>
        </section>

        <section class="prose-block" id="add-and-style-locations">
          <p class="step-kicker">Step 4</p>
          <h2>Add more locations, style the markers, and select Share</h2>
          <p>
            Repeat the search and <strong>Add to map</strong> process for every location. Each saved place appears in the layer list. Select a marker’s style icon to change its color or choose a more descriptive symbol. For example, stores can use one color, pickup points another, and offices a third.
          </p>
          <p>
            Rename unclear entries and add descriptions where visitors need phone numbers, opening hours, parking details, or booking information. Use separate layers for different categories when visitors may want to show or hide groups of markers. When the map is complete, select <strong>Share</strong>.
          </p>
          <figure class="step-figure">
            <img src={steps[3].image} alt={steps[3].alt} width="1280" height="720" loading="lazy" />
            <figcaption>Add the remaining places, customize their marker colors, and then select “Share.”</figcaption>
          </figure>
          <div class="callout">
            <strong>Usability tip:</strong> use the real business or venue name for each marker. Labels such as “Location 1” are harder for visitors to understand.
          </div>
        </section>

        <section class="prose-block" id="share-and-copy-link">
          <p class="step-kicker">Step 5</p>
          <h2>Allow link access and copy the Google My Maps URL</h2>
          <p>
            In the sharing dialog, enable <strong>Anyone with this link can view</strong>. Viewer access is sufficient; website visitors do not need permission to edit the map. Copy the URL shown in the dialog using the copy button beside it.
          </p>
          <p>
            Test the copied link in a private or incognito browser window. If the map opens without asking for access, its permissions are ready. If it requests a sign-in or permission, return to Share and check the link-viewing setting.
          </p>
          <figure class="step-figure">
            <img src={steps[4].image} alt={steps[4].alt} width="1280" height="720" loading="lazy" />
            <figcaption>Enable “Anyone with this link can view,” then copy the shared My Maps URL.</figcaption>
          </figure>
        </section>

        <section class="prose-block" id="responsive-code">
          <p class="step-kicker">Step 6</p>
          <h2>Paste the URL and generate responsive embed code</h2>
          <p>
            Return to the <a href="/#generator">Map Embed Code generator</a>, select the <strong>My Maps</strong> tab, and paste the copied URL into the <strong>My Maps embed URL or iframe code</strong> field. The generator accepts the shared Google My Maps URL and converts it into an embeddable map preview.
          </p>
          <ol class="styled-list">
            <li>Confirm that every saved marker appears in the live preview.</li>
            <li>Choose a dimension preset or enter a custom width and height.</li>
            <li>Keep responsive mode enabled so the map fits mobile screens.</li>
            <li>Select <strong>Generate Code</strong>, then copy the finished HTML from the popup.</li>
          </ol>
          <figure class="step-figure">
            <img src={steps[5].image} alt={steps[5].alt} width="1280" height="720" loading="lazy" />
            <figcaption>Paste the shared URL, check the multiple-marker preview, and select “Generate Code.”</figcaption>
          </figure>
        </section>

        <section class="prose-block" id="publish">
          <h2>Paste the multiple-location map into your website</h2>
          <p>
            Add the generated code in an HTML or embed block on the page where the map should appear. Use a page preview before publishing and check the map at desktop and mobile widths.
          </p>
          <ul class="styled-list">
            <li><strong>WordPress:</strong> paste it into a Custom HTML block. See the <a href="/guides/embed-google-maps-wordpress/">WordPress map embed guide</a>.</li>
            <li><strong>Shopify:</strong> use a Custom Liquid or HTML-capable section. See the <a href="/guides/embed-google-maps-shopify/">Shopify map embed guide</a>.</li>
            <li><strong>Wix, Squarespace, or Webflow:</strong> place it in the platform’s Embed Code or HTML Embed element.</li>
            <li><strong>Plain HTML:</strong> paste it inside the page’s <code>&lt;body&gt;</code> where the map should render.</li>
          </ul>
        </section>

        <section class="prose-block" id="bulk-import">
          <h2>How to add many locations at once with CSV or Google Sheets</h2>
          <p>
            Adding a handful of pins manually is quick. For dozens or hundreds of locations, prepare a spreadsheet with a header row and at least one column containing addresses, place names, or latitude and longitude values.
          </p>
          <ol class="styled-list">
            <li>In My Maps, create or select a layer.</li>
            <li>Click <strong>Import</strong> under the layer name.</li>
            <li>Upload a CSV, XLSX, KML, KMZ, GPX, TSV file, or select a Google Sheet.</li>
            <li>Choose the columns My Maps should use to position the markers.</li>
            <li>Choose the column that should become each marker’s title.</li>
            <li>Review unmatched rows and correct any incomplete addresses.</li>
          </ol>
          <p>
            Google documents a limit of 2,000 rows per imported layer. Splitting a larger list into clear categories also makes the final map easier for visitors to use.
          </p>
        </section>

        <section class="prose-block" id="markers-vs-directions">
          <h2>Multiple markers versus multi-stop directions</h2>
          <p>
            This method displays several independent locations on one map. It does not automatically connect them as a route. Use multiple markers for branch finders, property listings, service areas, venue guides, and pickup points. Use multi-stop directions when visitors need an ordered route from an origin through intermediate stops to a destination.
          </p>
        </section>

        <section class="prose-block" id="troubleshooting">
          <h2>Troubleshooting a Google Map with multiple locations</h2>
          <dl class="troubleshooting-list">
            <div>
              <dt>The embedded map asks visitors to sign in</dt>
              <dd>Return to My Maps sharing settings and allow public or link-based viewing. Test the map in an incognito window.</dd>
            </div>
            <div>
              <dt>One or more pins appear in the wrong place</dt>
              <dd>Use the complete address, including city and postal code, or replace the address with exact latitude and longitude coordinates.</dd>
            </div>
            <div>
              <dt>The map is cut off on mobile</dt>
              <dd>Generate the code again with responsive mode enabled. Also check that the parent page column does not have a fixed minimum width.</dd>
            </div>
            <div>
              <dt>New markers do not appear on the website</dt>
              <dd>Confirm you edited the same My Map used by the iframe, save the changes, and refresh the page without browser cache.</dd>
            </div>
            <div>
              <dt>The copied My Maps URL is rejected</dt>
              <dd>Copy the complete URL from the Google My Maps sharing dialog. Confirm that it belongs to google.com/maps/d and that link viewing is enabled.</dd>
            </div>
          </dl>
        </section>

        <section class="prose-block faq-section" id="faq">
          <h2>Frequently asked questions</h2>
          <details>
            <summary>Can I embed multiple locations without a Google Maps API key?</summary>
            <p>Yes. Create the markers in Google My Maps, enable link viewing, and paste the shared URL into the generator. You need a Google account to create the map, but this workflow does not ask for a Maps API key.</p>
          </details>
          <details>
            <summary>How many locations can I put on one map?</summary>
            <p>Google states that a My Map can contain up to 10,000 places, lines, or shapes. A single layer can contain up to 2,000 features, so larger maps should use several well-named layers.</p>
          </details>
          <details>
            <summary>Can visitors filter the locations?</summary>
            <p>Visitors can show or hide layers. Organize categories such as stores, warehouses, and pickup points into separate layers to provide a simple filter.</p>
          </details>
          <details>
            <summary>Will edits update the embedded map?</summary>
            <p>Yes. The iframe loads the saved My Map, so changes to its locations or styles usually appear without replacing the embed code.</p>
          </details>
          <details>
            <summary>Does this create directions between every location?</summary>
            <p>No. It creates a map with multiple pins. Directions are a separate feature for an ordered route.</p>
          </details>
        </section>

        <section class="sources" aria-labelledby="sources-title">
          <h2 id="sources-title">Official Google references</h2>
          <ul>
            <li><a href="https://support.google.com/mymaps/answer/3024454?hl=en" target="_blank" rel="noopener noreferrer">Create or open a map</a></li>
            <li><a href="https://support.google.com/mymaps/answer/3024925?hl=en" target="_blank" rel="noopener noreferrer">Add places to your map</a></li>
            <li><a href="https://support.google.com/mymaps/answer/3109452?hl=en" target="_blank" rel="noopener noreferrer">Share or embed a map</a></li>
            <li><a href="https://support.google.com/mymaps/answer/3024836?hl=en" target="_blank" rel="noopener noreferrer">Import map features from a file</a></li>
          </ul>
        </section>

        <div class="guide-cta-card card">
          <div>
            <h2>Make your My Maps embed responsive</h2>
            <p>Paste your Google My Maps iframe and generate clean embed code for your website.</p>
          </div>
          <a href="/#generator" class="btn-primary">Open the Generator</a>
        </div>
      </article>
    </div>
  </main>
  <Footer lang="en" />
</BaseLayout>

<style>
  .page-hero { padding: var(--spacing-3xl) 0 var(--spacing-xl); border-bottom: 1px solid var(--color-hairline); }
  .hero-surface { max-width: 960px; }
  .breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-bottom: var(--spacing-md); font-size: 13px; color: var(--color-mute); }
  .breadcrumb a { color: var(--color-link); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .page-h1 { max-width: 820px; margin: var(--spacing-sm) 0; color: var(--color-ink); }
  .hero-copy { max-width: 780px; margin: 0; color: var(--color-body); }
  .article-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: var(--spacing-md); color: var(--color-mute); font-size: 13px; }

  .prose-section { padding: var(--spacing-3xl) 0; }
  .prose-container { max-width: 820px; }
  .intro { margin: 0 0 var(--spacing-lg); font-size: 17px; line-height: 28px; color: var(--color-body); }

  .quick-answer { margin: 0 0 var(--spacing-2xl); padding: 18px 20px; background: var(--color-map-green-soft); border: 1px solid #c9ddce; border-left: 4px solid var(--color-map-green); border-radius: var(--radius-md); }
  .quick-answer h2 { margin: 0 0 6px; font-size: 18px; color: var(--color-ink); }
  .quick-answer p { margin: 0; font-size: 15px; line-height: 24px; color: var(--color-body); }
  .quick-answer a { color: var(--color-map-green-deep); font-weight: 600; }

  .toc { margin-bottom: var(--spacing-2xl); }
  .toc-heading { margin: 0 0 var(--spacing-sm); font-size: 16px; font-weight: 600; color: var(--color-ink); }
  .toc-list { display: grid; gap: 7px; margin: 0; padding-left: var(--spacing-lg); }
  .toc-list li { font-size: 14px; line-height: 21px; }
  .toc-list a { color: var(--color-link); text-decoration: none; }
  .toc-list a:hover { text-decoration: underline; }

  .prose-block { scroll-margin-top: 84px; margin-bottom: var(--spacing-2xl); }
  .prose-block > h2 { margin: 0 0 var(--spacing-sm); padding-top: var(--spacing-md); border-top: 1px solid var(--color-hairline); font-family: var(--font-sans); font-size: 24px; line-height: 32px; font-weight: 600; letter-spacing: -.35px; color: var(--color-ink); }
  .prose-block p { margin: 0 0 var(--spacing-sm); font-size: 15px; line-height: 25px; color: var(--color-body); }
  .prose-block a, .sources a { color: var(--color-link); text-decoration: none; }
  .prose-block a:hover, .sources a:hover { text-decoration: underline; }
  .prose-block code { padding: 2px 5px; border: 1px solid var(--color-hairline); border-radius: 4px; background: var(--color-hairline-soft); font-family: var(--font-mono); font-size: .88em; color: var(--color-ink); }
  .step-kicker { margin-bottom: 4px !important; font-family: var(--font-mono); font-size: 12px !important; line-height: 18px !important; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--color-map-green) !important; }

  .styled-list { display: flex; flex-direction: column; gap: 8px; margin: 0 0 var(--spacing-sm); padding-left: var(--spacing-lg); font-size: 15px; line-height: 25px; color: var(--color-body); }
  .step-figure { overflow: hidden; margin: var(--spacing-lg) 0; border: 1px solid var(--color-hairline); border-radius: var(--radius-md); background: #f7faf7; }
  .step-figure img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .step-figure figcaption { padding: 10px 14px; border-top: 1px solid var(--color-hairline); background: #fff; font-size: 13px; line-height: 19px; color: var(--color-mute); }

  .video-frame { position: relative; overflow: hidden; width: 100%; margin: var(--spacing-lg) 0 var(--spacing-xs); padding-bottom: 56.25%; border-radius: var(--radius-md); background: #111; box-shadow: 0 10px 28px rgba(0,0,0,.14); }
  .video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
