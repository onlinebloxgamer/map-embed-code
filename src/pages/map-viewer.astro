<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>Location map | Map Embed Code</title>
  </head>
  <body>
    <main>
      <header id="shared-description" hidden><h1 id="shared-title"></h1><p id="map-description" hidden></p></header>
      <p id="viewer-status" role="status">Loading map…</p>
      <div id="viewer" class="mm-canvas" aria-label="Interactive location map" hidden></div>
      <ul id="shared-locations" aria-label="Map locations" hidden></ul>
      <noscript>Enable JavaScript to view this interactive location map.</noscript>
    </main>
    <script is:inline id="saved-map-data" type="application/json">null</script>
    <script>
      import { mapSchema } from '../lib/multiple-maps/schema';
      const status = document.querySelector<HTMLParagraphElement>('#viewer-status')!;
      const canvas = document.querySelector<HTMLDivElement>('#viewer')!;
      const [kind] = location.pathname.split('/').filter(Boolean);
      async function load() {
        const snapshot = JSON.parse(document.querySelector('#saved-map-data')?.textContent ?? 'null');
        if (!snapshot) throw new Error('This map is unavailable. Check the link or ask the map creator for a current URL.');
        const mapData = mapSchema.parse(snapshot.configuration);
        document.title = `${mapData.title} | Map Embed Code`;
        if (kind === 'map') {
          const summary = document.querySelector<HTMLElement>('#shared-description')!;
          summary.hidden = false;
          document.querySelector('#shared-title')!.textContent = mapData.title;
          const description = document.querySelector<HTMLParagraphElement>('#map-description')!;
          description.textContent = mapData.description;
          description.hidden = !mapData.description;
        }
        let map: ReturnType<typeof import('../lib/multiple-maps/maplibre').mountMap> | undefined;
        try {
          const { mountMap } = await import('../lib/multiple-maps/maplibre');
          canvas.hidden = false;
          map = mountMap(canvas, mapData.markers, mapData.settings, { tileStatus(available) {
            status.textContent = 'The basemap is unavailable. You can still open the location markers.';
            status.hidden = available;
          } });
        } catch {
          canvas.hidden = true;
          status.hidden = false;
          status.textContent = 'The interactive map could not load. The saved locations are listed below.';
        }
        if (kind === 'map' || !map) {
          const list = document.querySelector<HTMLUListElement>('#shared-locations')!;
          mapData.markers.forEach((marker, index) => {
            const row = document.createElement('li');
            if (!map) {
              row.textContent = [marker.title, marker.address, `${marker.lat}, ${marker.lng}`].filter(Boolean).join(' · ');
              list.append(row);
              return;
            }
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = marker.title;
            button.addEventListener('click', () => map?.show(index));
            row.append(button);
            list.append(row);
          });
          list.hidden = false;
        }
      }
      void load().catch((error: unknown) => {
        status.textContent = error instanceof Error && error.message.startsWith('This map')
          ? error.message : 'The map could not load. Refresh the page to try again.';
      });
    </script>
  </body>
</html>

<style>
  :global(html), :global(body) { margin: 0; min-height: 100%; font-family: system-ui, sans-serif; color: #171717; }
  main { display: flex; flex-direction: column; min-height: 100dvh; }
  #viewer { width: 100%; flex: 1; min-height: 150px; }
  header, #viewer-status, noscript { padding: .75rem 1rem; margin: 0; }
  h1 { margin: 0; font-size: clamp(1.1rem, 3vw, 1.6rem); overflow-wrap: anywhere; }
  #map-description { margin: .25rem 0 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  ul { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0; padding: .65rem 1rem; }
  button { padding: .35rem .55rem; border: 1px solid #bacfc4; border-radius: .35rem; color: #205e38; background: white; font: inherit; cursor: pointer; }
  [hidden] { display: none !important; }
</style>
