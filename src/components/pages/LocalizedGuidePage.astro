---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../layout/Header.astro";
import Footer from "../layout/Footer.astro";
import { localizedPath, localizedUrl } from "../../i18n/config";
import { guidePaths, localizedGuides, type GuideKey, type TranslatedLocale } from "../../i18n/guides";

interface Props {
    lang: TranslatedLocale;
    guide: GuideKey;
}

const { lang, guide } = Astro.props;
const content = localizedGuides[lang][guide];
const alternatePath = guidePaths[guide];
const pageUrl = localizedUrl(alternatePath, lang, Astro.site!);
const home = localizedPath("/", lang);
const guidesPath = localizedPath("/guides/", lang);
const stripMarkup = (value: string) => value.replace(/<[^>]*>/g, "").replace(/&[^;]+;/g, " ").trim();
const howToSections = content.sections.filter((section) => section.kicker || section.ordered);

const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: content.title,
    description: content.description,
    dateModified: "2026-10-20",
    inLanguage: lang,
    author: { "@type": "Organization", name: "Map Embed Code" },
    publisher: {
        "@type": "Organization",
        name: "Map Embed Code",
        url: "https://map-embed-code.com/",
    },
    mainEntityOfPage: pageUrl,
};

const howToSchema = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: content.title,
    description: content.description,
    inLanguage: lang,
    step: howToSections.map((section, index) => ({
        "@type": "HowToStep",
        position: index + 1,
        name: section.title,
        url: `${pageUrl}#${section.id}`,
        text: stripMarkup(section.paragraphs?.[0] ?? section.ordered?.join(" ") ?? section.title),
        ...(section.image ? { image: new URL(section.image, Astro.site).href } : {}),
    })),
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: lang,
    mainEntity: content.faqs.map(([question, answer]) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
    })),
};
---

<BaseLayout
    title={content.seoTitle}
    description={content.description}
    canonical={pageUrl}
    ogImage={guide === "multipleLocations" ? "/guides/multiple-locations-video-thumbnail.jpg" : "/og-image.png"}
    ogType="article"
    modifiedTime="2026-10-20"
    structuredData={[articleSchema, howToSchema, faqSchema]}
    lang={lang}
    alternatePath={alternatePath}
>
    <Header lang={lang} translationPath={alternatePath} />
    <main id="main-content">
        <div class="page-hero">
            <div class="container readable-surface hero-surface">
                <nav class="breadcrumb" aria-label="Breadcrumb">
                    <a href={guidesPath}>{content.breadcrumb}</a><span aria-hidden="true">/</span><span>{content.platform}</span>
                </nav>
                <span class="text-mono-eyebrow">{content.platform}</span>
                <h1 class="text-heading-lg page-h1">{content.title}</h1>
                <p class="text-body-lg hero-copy">{content.lead}</p>
                <div class="article-meta">
                    <span>{content.updated}</span><span aria-hidden="true">•</span><span>{content.readTime}</span>
                </div>
            </div>
        </div>

        <div class="prose-section">
            <article class="container prose-container readable-surface">
                <p class="intro">{content.intro}</p>

                <aside class="quick-answer" aria-labelledby="quick-answer-title">
                    <h2 id="quick-answer-title">{content.quickAnswerTitle}</h2>
                    <p set:html={content.quickAnswer} />
                </aside>

                <nav class="toc card" aria-labelledby="toc-title">
                    <h2 class="toc-heading" id="toc-title">{content.contents}</h2>
                    <ol class="toc-list">
                        {content.sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}
                        <li><a href="#faq">{content.faqTitle}</a></li>
                    </ol>
                </nav>

                {content.sections.map((section) => (
                    <section class="prose-block" id={section.id}>
                        {section.kicker && <p class="step-kicker">{section.kicker}</p>}
                        <h2>{section.title}</h2>
                        {section.paragraphs?.map((paragraph) => <p set:html={paragraph} />)}
                        {section.ordered && (
                            <ol class="styled-list">
                                {section.ordered.map((item) => <li set:html={item} />)}
                            </ol>
                        )}
                        {section.bullets && (
                            <ul class="styled-list">
                                {section.bullets.map((item) => <li set:html={item} />)}
                            </ul>
                        )}
                        {section.video && (
                            <>
                                <div class="video-frame">
                                    <iframe src={section.video.src} title={section.video.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                                </div>
                                <p class="media-caption"><a href={section.video.link} target="_blank" rel="noopener noreferrer">{section.video.label}</a></p>
                            </>
                        )}
                        {section.image && (
                            <figure class="step-figure">
                                <img src={section.image} alt={section.imageAlt ?? ""} width="1280" height="720" loading="lazy" />
                                {section.caption && <figcaption>{section.caption}</figcaption>}
                            </figure>
                        )}
                        {section.callout && <div class="callout" set:html={section.callout} />}
                    </section>
                ))}

                <section class="prose-block faq-section" id="faq">
                    <h2>{content.faqTitle}</h2>
                    {content.faqs.map(([question, answer]) => (
                        <details>
                            <summary>{question}</summary>
                            <p>{answer}</p>
                        </details>
                    ))}
                </section>

                {content.sources && content.sourcesTitle && (
                    <section class="sources" aria-labelledby="sources-title">
                        <h2 id="sources-title">{content.sourcesTitle}</h2>
                        <ul>
                            {content.sources.map(([label, href]) => <li><a href={href} target="_blank" rel="noopener noreferrer">{label}</a></li>)}
                        </ul>
                    </section>
                )}

                <div class="guide-cta-card card">
                    <div>
                        <h2>{content.ctaTitle}</h2>
                        <p>{content.ctaText}</p>
                    </div>
                    <a href={`${home}#generator`} class="btn-primary">{content.ctaButton}</a>
                </div>
            </article>
        </div>
    </main>
    <Footer lang={lang} />
</BaseLayout>

<style>
    .page-hero { padding: var(--spacing-3xl) 0 var(--spacing-xl); border-bottom: 1px solid var(--color-hairline); }
    .hero-surface { max-width: 960px; }
    .breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-bottom: var(--spacing-md); color: var(--color-mute); font-size: 13px; }
    .breadcrumb a, .prose-block :global(a), .sources a, .quick-answer :global(a) { color: var(--color-link); text-decoration: none; }
    .breadcrumb a:hover, .prose-block :global(a:hover), .sources a:hover, .quick-answer :global(a:hover) { text-decoration: underline; }
    .text-mono-eyebrow { color: var(--color-mute); }
    .page-h1 { max-width: 820px; margin: var(--spacing-sm) 0; color: var(--color-ink); }
    .hero-copy { max-width: 780px; margin: 0; color: var(--color-body); }
    .article-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: var(--spacing-md); color: var(--color-mute); font-size: 13px; }
    .prose-section { padding: var(--spacing-3xl) 0; }
    .prose-container { max-width: 820px; }
    .intro { margin: 0 0 var(--spacing-lg); color: var(--color-body); font-size: 17px; line-height: 28px; }
    .quick-answer { margin: 0 0 var(--spacing-2xl); padding: 18px 20px; border: 1px solid #c9ddce; border-left: 4px solid var(--color-map-green); border-radius: var(--radius-md); background: var(--color-map-green-soft); }
    .quick-answer h2 { margin: 0 0 6px; color: var(--color-ink); font-size: 18px; }
    .quick-answer p { margin: 0; color: var(--color-body); font-size: 15px; line-height: 24px; }
    .toc { margin-bottom: var(--spacing-2xl); }
    .toc-heading { margin: 0 0 var(--spacing-sm); color: var(--color-ink); font-size: 14px; font-weight: 600; }
    .toc-list { display: flex; flex-direction: column; gap: 6px; margin: 0; padding-left: var(--spacing-lg); }
    .toc-list li { font-size: 14px; }
    .toc-list a { color: var(--color-link); text-decoration: none; }
    .toc-list a:hover { text-decoration: underline; }
    .prose-block { margin-bottom: var(--spacing-2xl); scroll-margin-top: 80px; }
    .prose-block > h2 { margin: 0 0 var(--spacing-sm); padding-top: var(--spacing-md); border-top: 1px solid var(--color-hairline); color: var(--color-ink); font-family: var(--font-sans); font-size: 23px; font-weight: 600; line-height: 31px; }
    .step-kicker { margin: 0 0 4px !important; color: var(--color-map-green-deep) !important; font-family: var(--font-mono); font-size: 12px !important; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; }
    .prose-block > p { margin: 0 0 var(--spacing-sm); color: var(--color-body); font-size: 15px; line-height: 25px; }
    .styled-list { display: flex; flex-direction: column; gap: 8px; margin: 0 0 var(--spacing-sm); padding-left: var(--spacing-lg); color: var(--color-body); font-size: 15px; line-height: 24px; }
    .prose-block :global(code) { padding: 1px 5px; border: 1px solid var(--color-hairline); border-radius: 4px; background: var(--color-hairline-soft); font-family: var(--font-mono); font-size: 13px; }
    .callout { margin: var(--spacing-sm) 0; padding: var(--spacing-sm) var(--spacing-md); border: 1px solid #c9ddce; border-left: 3px solid var(--color-map-green); border-radius: var(--radius-sm); background: #f3f8f4; color: var(--color-body); font-size: 14px; line-height: 22px; }
    .step-figure { overflow: hidden; margin: var(--spacing-md) 0 var(--spacing-lg); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); background: #fff; }
    .step-figure img { display: block; width: 100%; height: auto; }
    .step-figure figcaption { padding: 10px 13px; border-top: 1px solid var(--color-hairline); color: var(--color-mute); font-size: 12px; line-height: 18px; }
    .video-frame { position: relative; overflow: hidden; width: 100%; margin: var(--spacing-md) 0; border-radius: var(--radius-md); background: #111; box-shadow: 0 10px 28px rgba(0,0,0,.14); aspect-ratio: 16 / 9; }
    .video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .media-caption { color: var(--color-mute) !important; font-size: 13px !important; }
    .faq-section details { margin-bottom: 9px; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); background: #fff; }
    .faq-section summary { padding: 13px 16px; cursor: pointer; color: var(--color-ink); font-size: 15px; font-weight: 600; }
    .faq-section details p { margin: 0; padding: 0 16px 14px; }
    .sources { margin-top: var(--spacing-xl); padding-top: var(--spacing-lg); border-top: 1px solid var(--color-hairline); }
    .sources h2 { margin: 0 0 8px; color: var(--color-ink); font-size: 16px; }
    .sources ul { display: flex; flex-wrap: wrap; gap: 5px 18px; margin: 0; padding-left: 19px; font-size: 13px; }
    .guide-cta-card { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-lg); margin-top: var(--spacing-2xl); border-color: #c9ddce; background: #f5faf6; }
    .guide-cta-card h2 { margin: 0 0 5px; color: var(--color-ink); font-size: 20px; }
    .guide-cta-card p { margin: 0; color: var(--color-body); font-size: 14px; }
    @media (max-width: 640px) {
        .page-hero { padding: var(--spacing-xl) 0 var(--spacing-md); }
        .page-h1 { font-size: 29px; line-height: 35px; letter-spacing: -.8px; }
        .prose-section { padding: var(--spacing-xl) 0; }
        .prose-container.readable-surface { padding: var(--spacing-md); }
        .prose-block > h2 { font-size: 21px; line-height: 28px; }
        .guide-cta-card { align-items: stretch; flex-direction: column; }
        .guide-cta-card .btn-primary { width: 100%; }
    }
</style>
