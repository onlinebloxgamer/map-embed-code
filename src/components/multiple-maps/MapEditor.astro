---
import { defaultLocale, isLocale } from '../../i18n/config';
import { editorCopy } from '../../i18n/map-editor';
import { COLORS } from '../../lib/multiple-maps/schema';
import '../../styles/multiple-map-editor.css';

const lang = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const copy = editorCopy[lang];
---

<section id="location-editor" class="mm-editor" aria-label={copy.editor} inert>
  <div class="mm-workspace">
    <div class="mm-sidebar card">
      <div class="mm-panel-heading"><h2>{copy.locations}</h2><span id="mm-count">0 / 20</span></div>
      <form id="mm-search" class="mm-stack" role="search">
        <label for="mm-query">{copy.search}</label>
        <div class="mm-input-row">
          <input class="input" id="mm-query" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" minlength="3" maxlength="300" required />
          <button class="btn-sm" type="submit">{copy.addLocation}</button>
        </div>
        <small id="mm-search-note" role="status"></small>
        <ul id="mm-suggestions" class="mm-suggestions" aria-label={copy.suggestions} hidden></ul>
        <small>{copy.searchProvider.split(/(\{photon\}|\{osm\})/).map((part) =>
          part === '{photon}' ? <a href="https://github.com/komoot/photon">Photon</a> :
          part === '{osm}' ? <a href="https://www.openstreetmap.org/copyright">{copy.osm}</a> : part)}</small>
      </form>
      <div class="mm-actions mm-entry-actions">
        <button type="button" id="mm-coordinates" class="btn-ghost-sm">{copy.coordinates}</button>
        <button type="button" id="mm-csv" class="btn-ghost-sm">{copy.csv}</button>
      </div>
      <p id="mm-empty" class="mm-empty">{copy.empty}</p>
      <ol id="mm-locations" class="mm-locations" aria-label={copy.addedLocations}></ol>
      <button type="button" id="mm-example" class="mm-text-button">{copy.example}</button>
      <p id="mm-edit-status" class="mm-secondary-text" role="status"></p>
    </div>

    <section id="mm-live-preview" class="mm-map-card card" aria-labelledby="mm-live-heading" tabindex="-1">
      <div class="mm-panel-heading mm-map-heading">
        <h2 id="mm-live-heading">{copy.liveMap}</h2>
        <div class="mm-actions">
          <button type="button" class="btn-ghost-sm" id="mm-fit" disabled>{copy.fitAll}</button>
          <button type="button" class="btn-ghost-sm" id="mm-map-pick" aria-pressed="false">{copy.dropPin}</button>
        </div>
      </div>
      <div class="mm-map-wrap"><div class="mm-canvas mm-editor-canvas" id="mm-canvas" aria-label={copy.preview}></div></div>
      <p id="mm-map-note" class="mm-map-note" role="status">{copy.loadingPreview}</p>
    </section>
  </div>

  <details class="mm-settings card" id="mm-settings-panel">
    <summary>{copy.customize}</summary>
    <form id="mm-settings" class="mm-settings-grid">
      <label>{copy.style}<select class="input" name="style"><option value="streets">Liberty</option><option value="bright">Bright</option><option value="light">Positron</option><option value="dark">Dark</option></select></label>
      <label>{copy.zoom}<input class="input" name="zoom" type="number" min="1" max="19" value="12" required /></label>
      <label>{copy.width}<input class="input" name="width" type="number" min="240" max="2400" value="800" required /></label>
      <label>{copy.height}<input class="input" name="height" type="number" min="200" max="1200" value="450" required /></label>
      <label class="mm-check"><input type="checkbox" name="responsive" checked /> Responsive width</label>
      <label class="mm-check"><input type="checkbox" name="fit" checked /> Fit markers on load</label>
      <label class="mm-check"><input type="checkbox" name="zoomControls" checked /> Show zoom controls</label>
      <label class="mm-check"><input type="checkbox" name="scrollWheel" /> Scroll-wheel zoom</label>
      <label class="mm-check"><input type="checkbox" name="cluster" checked /> Cluster nearby markers</label>
      <label class="mm-check"><input type="checkbox" name="labels" /> Show marker labels</label>
    </form>
  </details>

  <div class="mm-publish card">
    <h2>{copy.publish}</h2>
    <form id="mm-publish" class="mm-stack">
      <div class="mm-fields">
        <label>{copy.mapTitle}<input name="title" class="input" maxlength="120" value={copy.defaultTitle} required /></label>
        <label>{copy.mapDescription} <span>{copy.optional}</span><textarea name="description" class="input" maxlength="1000" rows="2"></textarea></label>
      </div>
      <p class="mm-secondary-text">{copy.privacy.split('{privacyLink}').map((part, index) => index === 0 ? part : <>
        <a href="/privacy-policy/#multiple-location-maps" hreflang="en">{copy.privacyLink}</a>{part}</>)}</p>
      <div class="mm-actions">
        <button type="submit" id="mm-save" class="btn-primary">{copy.generate}</button>
        <button type="button" id="mm-recover" class="btn-secondary">{copy.recover}</button>
        <input type="file" id="mm-recovery-file" accept=".json,application/json" hidden />
      </div>
      <p id="mm-publish-status" role="status"></p>
    </form>

    <div id="mm-result" class="mm-result mm-stack" hidden>
      <h3>{copy.embedCode}</h3>
      <label for="mm-embed-code">{copy.htmlIframe}</label>
      <textarea id="mm-embed-code" class="input" rows="5" readonly spellcheck="false"></textarea>
      <label for="mm-share-url">{copy.shareUrl}</label>
      <input id="mm-share-url" type="url" class="input" readonly />
      <div class="mm-actions">
        <button type="button" id="mm-copy-code" class="btn-sm">{copy.copyCode}</button>
        <button type="button" id="mm-copy-url" class="btn-ghost-sm">{copy.copyUrl}</button>
        <a id="mm-preview" class="btn-ghost-sm" target="_blank" rel="noopener">{copy.previewMap}</a>
        <button type="button" id="mm-another" class="btn-ghost-sm">{copy.another}</button>
      </div>
      <p class="mm-secondary-text">{copy.recoveryNotice}</p>
      <div class="mm-actions">
        <button type="button" id="mm-download" class="btn-ghost-sm">{copy.download}</button>
        <button type="button" id="mm-delete-map" class="mm-text-button mm-danger">{copy.deleteMap}</button>
      </div>
      <p id="mm-copy-status" role="status"></p>
    </div>
  </div>

  <dialog id="mm-marker-dialog" class="mm-dialog" aria-labelledby="mm-marker-heading">
    <form id="mm-marker-form" class="mm-stack">
      <h2 id="mm-marker-heading">{copy.newMarker}</h2>
      <label>{copy.locationTitle}<input name="title" class="input" maxlength="120" required /></label>
      <label>{copy.address} <span>{copy.optional}</span><input name="address" class="input" maxlength="300" /></label>
      <label>{copy.description} <span>{copy.optional}</span><textarea name="description" class="input" rows="2" maxlength="1000"></textarea></label>
      <div class="mm-fields">
        <label>{copy.latitude}<input name="lat" class="input" inputmode="decimal" placeholder="28.6139" required /></label>
        <label>{copy.longitude}<input name="lng" class="input" inputmode="decimal" placeholder="77.2090" required /></label>
        <label>{copy.color}<select name="color" class="input">{(Object.keys(COLORS) as Array<keyof typeof COLORS>).map((color) => <option value={color}>{copy[color]}</option>)}<option value="custom">{copy.custom}</option></select></label>
        <label>{copy.icon}<select name="icon" class="input"><option value="number">{copy.numbered}</option><option value="pin">{copy.standard}</option><option value="circle">{copy.circle}</option></select></label>
      </div>
      <label id="mm-custom-color" hidden>{copy.customColor}<input name="customColor" class="input" type="color" value="#e63946" /></label>
      <p id="mm-marker-error" role="alert"></p>
      <div class="mm-actions"><button class="btn-sm" type="submit">{copy.saveLocation}</button><button class="btn-ghost-sm" type="button" data-close>{copy.cancel}</button></div>
    </form>
  </dialog>

  <dialog id="mm-import-dialog" class="mm-dialog mm-import" aria-labelledby="mm-import-heading">
    <div class="mm-stack">
      <h2 id="mm-import-heading">{copy.csvHeading}</h2>
      <form id="mm-import-form" class="mm-stack">
        <div class="mm-stack">
          <label for="mm-csv-file">{copy.csvFile}</label>
          <input id="mm-csv-file" type="file" accept=".csv,text/csv" />
          <small>{copy.csvHelp.split(/(\{columns\}|\{lat\}|\{lon\})/).map((part) =>
            part === '{columns}' ? <code>title,address,lat,lon,description,color</code> :
            part === '{lat}' ? <code>latitude</code> : part === '{lon}' ? <code>longitude</code> : part)}</small>
          <a href="/examples/multiple-map-locations.csv" download>{copy.sampleCsv}</a>
        </div>
        <button type="submit" class="btn-ghost-sm" id="mm-preview-import">{copy.previewLocations}</button>
      </form>
      <p id="mm-import-status" role="status"></p>
      <ol id="mm-import-rows" class="mm-locations"></ol>
      <div class="mm-actions">
        <button type="button" class="btn-sm" id="mm-run-import" hidden>{copy.addLocations}</button>
        <button type="button" class="btn-ghost-sm" id="mm-close-import" data-close>{copy.close}</button>
      </div>
    </div>
  </dialog>

  <dialog id="mm-verification" class="mm-dialog" aria-labelledby="mm-verify-title">
    <div class="mm-stack">
      <h2 id="mm-verify-title">{copy.verifyTitle}</h2>
      <p>{copy.verifyText}</p>
      <div id="mm-turnstile"></div>
      <button type="button" class="btn-ghost-sm" data-close>{copy.cancel}</button>
    </div>
  </dialog>
</section>
<p id="mm-initial-status" class="mm-secondary-text" role="status">{copy.loading}</p>
<noscript><p>{copy.noScript}</p></noscript>

<script>
  import { startEditor } from '../../lib/multiple-maps/editor';
  void startEditor();
</script>
