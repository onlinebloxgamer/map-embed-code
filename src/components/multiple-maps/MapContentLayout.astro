---
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLocale, isLocale, localizedPath, localizedUrl } from '../../i18n/config';
import { multipleMapsFeatures, multipleMapsNavigation, multipleMapsPath, multiplePinsGuidePath } from '../../i18n/multiple-maps';
import { guideArticleStructuredData } from '../../lib/guide-structured-data';
import '../../styles/multiple-map-content.css';

interface Props {
  title: string;
  description: string;
  heading: string;
  intro: string;
  kind: 'tool' | 'article';
}

const { title, description, heading, intro, kind } = Astro.props;
const lang = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const navigation = multipleMapsNavigation[lang];
const alternatePath = kind === 'tool' ? multipleMapsPath : multiplePinsGuidePath;
const canonical = localizedUrl(alternatePath, lang, Astro.site!);
const crumbs = [
  { name: navigation.home, path: localizedPath('/', lang) },
  ...(kind === 'article' ? [{ name: navigation.guides, path: localizedPath('/guides/', lang) }] : []),
  { name: heading, path: localizedPath(alternatePath, lang) },
];
const breadcrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.path, Astro.site!).href })),
};
const siteUrl = new URL('/', Astro.site!).href;
const application = {
  '@context': 'https://schema.org',
  name: heading, description, url: canonical, inLanguage: lang,
  '@type': 'WebApplication',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: multipleMapsFeatures[lang],
  isPartOf: { '@type': 'WebSite', name: 'Map Embed Code', url: siteUrl },
};
const structuredData = kind === 'tool'
  ? [breadcrumbs, application]
  : guideArticleStructuredData({
      site: Astro.site!, lang, url: canonical, title: heading, description,
      image: '/guides/native-multiple-map-editor.webp',
    });
---

<BaseLayout title={title} description={description} canonical={canonical} ogType={kind === 'article' ? 'article' : 'website'} ogImage="/images/google-map-embed-generator.webp" structuredData={structuredData} lang={lang} alternatePath={alternatePath}>
  <Header lang={lang} translationPath={alternatePath} />
  <main id="main-content" class="mm-content">
    <header class:list={['page-hero', 'mm-hero', { 'mm-hero-tool': kind === 'tool' }]}>
      <div class="container readable-surface">
        <nav aria-label={navigation.breadcrumb} class="mm-crumbs">
          <ol>{crumbs.map((item, index) => <li>{index === crumbs.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.path}>{item.name}</a>}</li>)}</ol>
        </nav>
        <h1 class="text-heading-lg">{heading}</h1>
        <p class="text-body-lg">{intro}</p>
      </div>
    </header>
    <div class="container mm-page">
      <slot />
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
