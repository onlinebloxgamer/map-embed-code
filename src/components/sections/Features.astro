---
import type { Locale } from "../../i18n/config";
import { getHomeContent } from "../../i18n/home";

interface Props { lang?: Locale; }
const { lang = "en" } = Astro.props;
const copy = getHomeContent(lang).features;
const features = copy.items.map(([icon, title, description]) => ({ icon, title, description }));
---

<section
    class="section features"
    id="features"
    aria-labelledby="features-heading"
>
    <div class="container">
        <div class="section-header">
            <span class="text-mono-eyebrow" style="color:var(--color-mute);"
                >{copy.eyebrow}</span
            >
            <h2 class="text-heading-lg section-title" id="features-heading">
                {copy.title}
            </h2>
        </div>

        <div class="features-grid">
            {
                features.map((f) => (
                    <div class="feature-card card">
                        <div class="feature-icon" aria-hidden="true">
                            {f.icon}
                        </div>
                        <h3 class="text-heading-md feature-title">{f.title}</h3>
                        <p
                            class="text-body-md feature-desc"
                            style="color:var(--color-body);"
                        >
                            {f.description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .features {
        background-color: var(--color-hairline-soft);
        border-top: 1px solid var(--color-hairline);
        border-bottom: 1px solid var(--color-hairline);
    }

    .section-header {
        text-align: center;
        margin-bottom: var(--spacing-xl);
    }

    .section-title {
        margin: var(--spacing-sm) 0 0;
        color: var(--color-ink);
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--spacing-md);
    }

    .feature-card {
    }

    .feature-icon {
        font-size: 24px;
        margin-bottom: var(--spacing-sm);
        line-height: 1;
    }

    .feature-title {
        margin: 0 0 var(--spacing-xs);
        color: var(--color-ink);
    }

    .feature-desc {
        margin: 0;
    }

    @media (max-width: 900px) {
        .features-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 540px) {
        .features-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
