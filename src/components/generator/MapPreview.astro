---
import type { Locale } from "../../i18n/config";
import { getHomeContent } from "../../i18n/home";

interface Props { lang?: Locale; }
const { lang = "en" } = Astro.props;
const copy = getHomeContent(lang).generator;
---

<div class="preview-panel">
    <!-- Device switcher -->
    <div class="device-bar">
        <span class="text-mono-eyebrow" style="color:var(--color-mute);"
            >{copy.preview}</span
        >
        <div class="device-btns" role="group" aria-label={copy.previewSize}>
            <button
                class="device-btn active"
                data-device="desktop"
                aria-pressed="true"
                title={copy.desktop}
            >
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 14 14"
                    fill="none"
                    aria-hidden="true"
                >
                    <rect
                        x="1"
                        y="1.5"
                        width="12"
                        height="8"
                        rx="1.5"
                        stroke="currentColor"
                        stroke-width="1.3"></rect>
                    <path
                        d="M4.5 12.5h5M7 9.5v3"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"></path>
                </svg>
                <span class="device-label">{copy.desktop}</span>
            </button>
            <button
                class="device-btn"
                data-device="tablet"
                aria-pressed="false"
                title={copy.tablet}
            >
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 14 14"
                    fill="none"
                    aria-hidden="true"
                >
                    <rect
                        x="2.5"
                        y="0.5"
                        width="9"
                        height="13"
                        rx="1.5"
                        stroke="currentColor"
                        stroke-width="1.3"></rect>
                    <circle cx="7" cy="11.5" r="0.8" fill="currentColor"
                    ></circle>
                </svg>
                <span class="device-label">{copy.tablet}</span>
            </button>
            <button
                class="device-btn"
                data-device="mobile"
                aria-pressed="false"
                title={copy.mobile}
            >
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 14 14"
                    fill="none"
                    aria-hidden="true"
                >
                    <rect
                        x="3.5"
                        y="0.5"
                        width="7"
                        height="13"
                        rx="1.5"
                        stroke="currentColor"
                        stroke-width="1.3"></rect>
                    <circle cx="7" cy="11.5" r="0.7" fill="currentColor"
                    ></circle>
                </svg>
                <span class="device-label">{copy.mobile}</span>
            </button>
        </div>
        <a
            href="#"
            id="open-gmaps-external"
            class="btn-ghost-sm"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.openMaps}
        >
            <svg
                width="12"
                height="12"
                viewBox="0 0 12 12"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M7 2H10V5"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                <path
                    d="M10 2L5 7"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"></path>
                <path
                    d="M5 2H2V10H10V7"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
            {copy.openMaps}
        </a>
    </div>

    <!-- Preview viewport -->
    <div class="preview-viewport" id="preview-viewport">
        <div class="preview-frame-wrapper" id="preview-frame-wrapper">
            <!-- Loading overlay -->
            <div
                class="preview-loading"
                id="preview-loading"
                aria-hidden="true"
            >
                <svg
                    class="loading-spinner"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                >
                    <circle
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="var(--color-hairline)"
                        stroke-width="2"></circle>
                    <path
                        d="M12 2a10 10 0 0 1 10 10"
                        stroke="var(--color-ink)"
                        stroke-width="2"
                        stroke-linecap="round"></path>
                </svg>
            </div>
            <!-- Map iframe -->
            <iframe
                id="map-preview-iframe"
                src="https://maps.google.com/maps?q=New+York+City%2C+NY%2C+USA&z=7&output=embed"
                width="600"
                height="450"
                style="border:0; display:block; width:100%; height:100%;"
                title={copy.mapPreview}
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                loading="lazy"></iframe>
        </div>
    </div>

    <!-- Preview info bar -->
    <div class="preview-info">
        <span class="preview-dims" id="preview-dims" aria-live="polite"
            >600px × 450px</span
        >
        <span class="preview-device-note" id="preview-device-note"
            >{copy.simulated}</span
        >
    </div>
</div>

<style>
    .preview-panel {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        height: 100%;
    }

    .device-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
    }

    .device-btns {
        display: flex;
        background-color: var(--color-hairline-soft);
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-sm);
        padding: 2px;
        gap: 2px;
    }

    .device-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 4px;
        border: none;
        background: transparent;
        color: var(--color-mute);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        transition:
            background-color 0.15s ease,
            color 0.15s ease;
    }
    .device-btn.active {
        background-color: var(--color-canvas-elevated);
        color: var(--color-ink);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    }
    .device-btn:hover:not(.active) {
        color: var(--color-ink);
    }

    @media (max-width: 480px) {
        .device-label {
            display: none;
        }
        .device-btn {
            padding: 5px 7px;
        }
    }

    .preview-viewport {
        background-color: var(--color-hairline-soft);
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-md);
        overflow: hidden;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        min-height: 350px;
        padding: var(--spacing-sm);
    }

    .preview-frame-wrapper {
        position: relative;
        width: 100%;
        height: 450px;
        background: var(--color-canvas-elevated);
        border-radius: var(--radius-sm);
        overflow: hidden;
        transition: max-width 0.3s ease;
    }

    .preview-loading {
        position: absolute;
        inset: 0;
        background: var(--color-canvas-elevated);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
    }
    .preview-loading.active {
        opacity: 1;
        pointer-events: auto;
    }

    .loading-spinner {
        animation: spin 1s linear infinite;
    }
    @keyframes spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .loading-spinner {
            animation: none;
        }
    }

    .preview-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .preview-dims,
    .preview-device-note {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--color-mute);
    }
</style>
